{
  "schemaVersion": 1,
  "id": "pandabuilder",
  "version": "${version}",
  "name": "Panda Builder",
  "description": "Schematic menu with material checking. Uses Baritone to walk to and place blocks from your inventory.",
  "authors": ["lethalluke1"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["pandabuilder.PandaBuilderClient"]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.1",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "baritone": "*"
  }
}
