{
  "schemaVersion": 1,
  "id": "pandabuilder",
  "version": "1.2.1",
  "name": "Panda Builder",
  "description": "Schematic menu with material checking, auto totem, base finder, storage run and freecam. Uses Baritone to walk to and place blocks from your inventory.",
  "authors": [
    "lethalluke1"
  ],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "pandabuilder.PandaBuilderClient"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "baritone": "*"
  },
  "mixins": [
    "pandabuilder.mixins.json"
  ]
}
