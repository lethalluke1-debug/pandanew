  "authors": ["lethalluke1"],
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["pandabuilder.PandaBuilderClient"]
  },
  "depends": {
    "fabricloader": ">=0.19.0",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "baritone": "*"
  }
}
